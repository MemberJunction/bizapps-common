{
  // Same hole this package's sibling closed, found while auditing #116. The build config excludes
  // `src/**/__tests__/**` so test files never reach `dist` — correct for a published package, but it
  // also meant this package's suite was never typechecked by anything. Vitest transpiles through
  // esbuild and does not typecheck either, so a test could construct a row missing three required
  // fields and stay green for as long as its assertions happened to hold. That exact mistake was
  // made in this branch's ActivitySync tests and caught only because ActivitySync has this file.
  //
  // This config typechecks everything and emits nothing. `pnpm test` runs it before vitest.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
