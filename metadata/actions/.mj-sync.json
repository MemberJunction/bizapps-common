{
  "entity": "MJ: Actions",
  "filePattern": "**/.*.json",
  "pull": {
    "createNewFileIfNotFound": true,
    "newFileName": ".common-actions.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "ignoreNullFields": true,
    "ignoreVirtualFields": true,
    "filter": "Name LIKE 'Common.%'",
    "relatedEntities": {
      "MJ: Action Params": { "entity": "MJ: Action Params", "foreignKey": "ActionID" },
      "MJ: Action Result Codes": { "entity": "MJ: Action Result Codes", "foreignKey": "ActionID" }
    }
  }
}
