{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "schema-info",
    "applications",
    "address-types",
    "contact-types",
    "organization-types",
    "relationship-types",
    "activity-sync-provider-types",
    "action-categories",
    "actions",
    "scheduled-jobs",
    "entities",
    "entity-fields",
    "entity-relationships",
    "application-roles",
    "action-filters",
    "agents",
    "entity-actions"
  ],
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "filterPatterns": [
      "*spCreateAIPromptRun*",
      "*spUpdateAIPromptRun*"
    ],
    "filterType": "exclude",
    "formatAsMigration": true,
    "variableBatchThreshold": 200
  },
  "emitSyncNotes": false
}
