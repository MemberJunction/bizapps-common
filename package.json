{
  "name": "bizapps-common",
  "private": true,
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "BizApps Common - Common business application entities (Person, Organization, Address, ContactMethod, Relationship) built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\u274c Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/common-entities\" --filter=\"@mj-biz-apps/common-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/common-*\"",
    "mj:migrate": "mj migrate --schema __mj_BizAppsCommon --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsCommon",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version && node scripts/sync-app-version.mjs",
    "test:objectmodel:pg": "node scripts/pg-objectmodel-test.mjs",
    "test:integration": "node test-harnesses/integration.mjs",
    "test:mutants": "pnpm -r --no-bail --workspace-concurrency=1 run test:mutants",
    "test:mutants:anchors": "pnpm -r --no-bail run test:mutants --check-anchors",
    "lint:entityfield-drift": "node .github/scripts/check-entityfield-drift.mjs",
    "lint:entityfield-drift:test": "node .github/scripts/check-entityfield-drift.mjs --self-test",
    "check:published-mj": "node scripts/check-against-published-mj.mjs",
    "check:release-seed": "node scripts/check-release-seed-coverage.mjs",
    "check:release-seed:test": "node --test scripts/check-release-seed-coverage.spec.mjs",
    "check:seed-cadence": "node scripts/check-release-seed-cadence.mjs",
    "check:seed-cadence:test": "node --test scripts/check-release-seed-cadence.spec.mjs",
    "sync-app-version:test": "node --test scripts/sync-app-version.spec.mjs",
    "lint:release-pushes": "node scripts/check-release-pushes.mjs",
    "lint:release-pushes:test": "node --test scripts/check-release-pushes.spec.mjs",
    "lint:paths-touched:test": "node --test scripts/check-paths-touched.spec.mjs",
    "lint:release-plan:test": "node --test scripts/release-plan.spec.mjs",
    "lint:release-prep:test": "node --test scripts/release-prep.spec.mjs",
    "release:plan": "node scripts/release-prep.mjs --plan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-common"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "~6.1.4",
    "@types/node": "^22.10.0",
    "beasties": "0.3.5",
    "mrmime": "2.0.1",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "6.1.4",
      "@memberjunction/global": "6.1.4"
    },
    "patchedDependencies": {
      "@memberjunction/codegen-lib@6.1.4": "patches/@memberjunction__codegen-lib@6.1.4.patch"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
